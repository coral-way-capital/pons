# Copy to .env, keep local, and chmod 600 .env.
DISCORD_BOT_TOKEN=
# Set your own channel ID; no channel is allowed until configured.
DISCORD_CHANNEL_ID=
# Optional comma-separated allowlist of your own channel IDs.
# Union with DISCORD_CHANNEL_ID first (default); otherwise the first list entry is default.
DISCORD_CHANNEL_IDS=
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=
PORT=8787
